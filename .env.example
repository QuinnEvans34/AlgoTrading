# API server
API_APP_NAME=capstone-research-api
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Research defaults
API_DEFAULT_STRICT_FAILURES=true
API_DEFAULT_PERSIST_SUMMARY=false
API_DEFAULT_RUN_OUTPUT_DIR=artifacts/research_runs

# Database persistence foundation
DATABASE_ENABLED=true
DATABASE_URL=postgresql+psycopg://capstone:capstone@127.0.0.1:5432/capstone
DATABASE_ECHO=false

# Paper trading defaults
API_DEFAULT_PAPER_TRADING_DIR=artifacts/paper_trading
API_PAPER_DEFAULT_ACCOUNT_ID=paper-main
API_PAPER_DEFAULT_BASE_CURRENCY=USD
API_PAPER_DEFAULT_INITIAL_CASH=100000
API_PAPER_DEFAULT_ALLOW_SHORT=false
API_PAPER_DEFAULT_SPREAD_BPS=0
API_PAPER_DEFAULT_SLIPPAGE_BPS=0
API_PAPER_DEFAULT_COMMISSION_BPS=0
API_PAPER_DEFAULT_COMMISSION_FIXED=0

# Market data provider (optional)
API_ENABLE_OANDA_PROVIDER=false
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_TIMEOUT_SECONDS=15

# Grounded AI research (optional)
AI_RESEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
AI_RESEARCH_TIMEOUT_SECONDS=30

# Live execution safety defaults (disabled by default)
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_ALLOW_ORDER_SUBMISSION=false
LIVE_EXECUTION_BROKER=null
LIVE_EXECUTION_REQUEST_TIMEOUT_SECONDS=10
LIVE_EXECUTION_CONFIRMATION_PHRASE=EXECUTE LIVE ORDER
# Directory is auto-created by `python scripts/dev.py bootstrap`
LIVE_EXECUTION_ATTEMPT_LOG_PATH=artifacts/live_execution/attempts.jsonl
LIVE_OANDA_API_TOKEN=
LIVE_OANDA_ACCOUNT_ID=
LIVE_OANDA_ENVIRONMENT=practice

# Feature flags
FEATURE_RESEARCH_API_ENABLED=true
FEATURE_HISTORY_API_ENABLED=true
FEATURE_COMPARE_API_ENABLED=true
FEATURE_PAPER_TRADING_ENABLED=true
FEATURE_LIVE_EXECUTION_STATUS_ENABLED=true
FEATURE_LIVE_EXECUTION_SUBMIT_ENABLED=false

# Frontend
# Used by frontend Vite client and local wrapper scripts.
# You can also place this value in frontend/.env.local for frontend-only override.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
